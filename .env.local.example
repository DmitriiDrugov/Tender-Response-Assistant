# OpenRouter — server-side only
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Tender Response Assistant

# Models via OpenRouter. Defaults are tuned for paid-tier.
OPENROUTER_MODEL_EXTRACT=anthropic/claude-sonnet-4-6
OPENROUTER_MODEL_MATCH=anthropic/claude-3-haiku
OPENROUTER_MODEL_DRAFT=anthropic/claude-3-haiku
OPENROUTER_MODEL_RISK=anthropic/claude-3-haiku

# Pipeline tuning. Defaults set for paid-tier models.
# MATCH_CHUNK_SIZE=20       # requirements per LLM call (default: 20)
# DRAFT_CONCURRENCY=5       # parallel draft workers; set to 1 for free-tier models (default: 5)
# DRAFT_PACING_MS=0         # ms between draft calls; set to 6000 for free-tier models (default: 0)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DB password is only required for direct psql / migrations; not used at runtime.
# SUPABASE_DB_PASSWORD=

# Auth — passcode gate for the demo
DEMO_PASSCODE=
# 32+ char random string used to sign the auth cookie
AUTH_COOKIE_SECRET=
