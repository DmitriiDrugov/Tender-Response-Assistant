# OpenRouter — server-side only
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Tender Response Assistant

# Free OpenRouter models — tune later
OPENROUTER_MODEL_EXTRACT=deepseek/deepseek-chat:free
OPENROUTER_MODEL_MATCH=deepseek/deepseek-chat:free
OPENROUTER_MODEL_DRAFT=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_RISK=deepseek/deepseek-chat:free

# Pipeline tuning — defaults are set for paid-tier models
# MATCH_CHUNK_SIZE=40       # requirements per LLM call (default: 40)
# DRAFT_CONCURRENCY=5       # parallel draft workers; set to 1 for free-tier models (default: 5)
# DRAFT_PACING_MS=0         # ms between draft calls; set to 6000 for free-tier models (default: 0)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=2SGw35nmkozaZqqS 


# Auth — passcode gate for the demo
DEMO_PASSCODE=
# 32+ char random string used to sign the auth cookie
AUTH_COOKIE_SECRET=
