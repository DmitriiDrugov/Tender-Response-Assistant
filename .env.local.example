# OpenRouter — server-side only
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Tender Response Assistant

# Models via OpenRouter. Defaults are free-tier.
OPENROUTER_MODEL_EXTRACT=deepseek/deepseek-chat:free
OPENROUTER_MODEL_MATCH=deepseek/deepseek-chat:free
OPENROUTER_MODEL_DRAFT=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_RISK=deepseek/deepseek-chat:free

# Pipeline tuning. Free-tier models need lower concurrency and pacing to stay under rate limits.
# MATCH_CHUNK_SIZE=20       # requirements per LLM call (default: 20)
# DRAFT_CONCURRENCY=1       # parallel draft workers; 1 is required for free-tier (default: 5)
# DRAFT_PACING_MS=6000      # ms between draft calls; 6000 is required for free-tier (default: 0)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DB password is only required for direct psql / migrations; not used at runtime.
# SUPABASE_DB_PASSWORD=

# Auth — passcode gate for the demo
DEMO_PASSCODE=
# 32+ char random string used to sign the auth cookie
AUTH_COOKIE_SECRET=
